# deploy/access.env: credentials for REACHING the cluster. Never go into it.
#   KUBE_CONFIG_B64 -> GitHub environment "production" (deploy.sh gh-secrets)
#                      and deploy.sh's own kubectl tunnel
# Gitignored, 0600. Can be re-issued, so losing it loses no data.

KUBE_CONFIG_B64=                 # vps-setup: ./run-remote.sh 06 kubeconfig
