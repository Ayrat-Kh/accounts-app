# deploy/config.env: every NON-secret deployment setting, in one place.
# Committed. Secrets go in deploy/app-secrets.env (into the cluster) and
# deploy/access.env (kubeconfig); both gitignored. Read by deploy/deploy.sh on
# your Mac and by the deploy job in .github/workflows/backend.yml.
# Plain bash assignments: no spaces around '='.

# --- Server (the same VPS and kube-deploy identity as ../obsidian, see vps-setup)
DEPLOY_HOST=72.60.213.90
DEPLOY_SSH_PORT=2222
KUBE_DEPLOY_SSH_KEY=$HOME/.ssh/kube_deploy

# --- accounts-api
ACCOUNTS_HOST=accounts.fernfall.cloud                       # public hostname (under the cluster's *.fernfall.cloud cert)
ACCOUNTS_IMAGE=ghcr.io/ayrat-kh/accounts-app/accounts-api   # pushed by .github/workflows/backend.yml
GHCR_USER=ayrat-kh                                          # owner of GHCR_PULL_TOKEN (app-secrets.env)
ACCOUNTS_REPLICAS=2
ALLOWED_EMAILS=aira3t@gmail.com                             # comma-separated Google accounts allowed to sign in
# comma-separated OAuth client ids whose Google ID tokens are accepted (Android + Web client)
GOOGLE_CLIENT_IDS=REPLACE_ME.apps.googleusercontent.com

# --- PostgreSQL
POSTGRES_IMAGE=postgres:17-trixie@sha256:2d2b8998d31037bf721cfdf764d76ba74171b4fab3431b7f72c27c56ddbdf9e3
POSTGRES_PVC_SIZE=10Gi

# --- Object storage: obsync's Garage (namespace app-obsync), with our own bucket and key
ACCOUNTS_BUCKET=accounts
RCLONE_IMAGE=rclone/rclone:1.71.2@sha256:3103526c506266a9ecdf064efe99bf3677d92ef6407af124d8c56b4f49cbaa51
