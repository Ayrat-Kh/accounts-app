# embed_migrations(OUTPUT <file.cpp> DIRECTORY <dir>)
#
# Generates a .cpp that defines accounts::db::embeddedMigrations(): every
# <dir>/NNN_name.sql file, sorted by name, as {name, sql} pairs. Re-runs
# whenever a migration file is added or edited.
function(embed_migrations)
    cmake_parse_arguments(ARG "" "OUTPUT;DIRECTORY" "" ${ARGN})
    file(GLOB migration_files CONFIGURE_DEPENDS "${ARG_DIRECTORY}/*.sql")
    list(SORT migration_files)

    set(entries "")
    foreach(path IN LISTS migration_files)
        get_filename_component(name "${path}" NAME_WE)
        file(READ "${path}" sql)
        # A raw string literal with a custom delimiter, so the SQL needs no escaping.
        string(APPEND entries "        {\"${name}\", R\"__sql__(${sql})__sql__\"},\n")
    endforeach()

    file(CONFIGURE OUTPUT "${ARG_OUTPUT}" CONTENT [=[
// Generated by cmake/EmbedMigrations.cmake. Do not edit.
#include "db/Migrator.hpp"

namespace accounts::db {

const std::vector<Migration> &embeddedMigrations() {
    static const std::vector<Migration> migrations = {
@entries@    };
    return migrations;
}

} // namespace accounts::db
]=] @ONLY)
endfunction()
