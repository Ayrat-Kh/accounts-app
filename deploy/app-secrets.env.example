# deploy/app-secrets.env: the secrets that go INTO the cluster, and nowhere else.
#   deploy/deploy.sh init       # creates this file and generates the ones marked (init)
#   deploy/deploy.sh secrets    # applies it as the Secrets accounts-secrets and ghcr
# Gitignored, 0600. Keep a copy in your password manager: the cluster Secret
# is not a backup. Plain bash assignments: no spaces around '=', no quotes.

JWT_ED25519_PEM_B64=             # (init) Ed25519 private key, PEM, base64 on one line
PG_PASSWORD=                     # (init) password of the "accounts" Postgres role
S3_ACCESS_KEY=                   # (init) Garage key accounts-api: GK + 24 hex; imported by garage-init
S3_SECRET_KEY=                   # (init) 64 hex
GHCR_PULL_TOKEN=                 # classic PAT with read:packages only
