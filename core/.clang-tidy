# Checks that catch real bugs or readability problems; noisy style-only
# checks are off. CI fails on any warning (WarningsAsErrors).
# bugprone-unchecked-optional-access is off: it cannot follow the
# `if (!result) return ...;` checks on std::expected, so it only cried wolf.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-unchecked-optional-access,
  cppcoreguidelines-avoid-goto,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-pro-type-member-init,
  misc-unused-using-decls,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  -performance-enum-size,
  readability-container-size-empty,
  readability-else-after-return,
  readability-identifier-naming,
  readability-make-member-function-const,
  readability-redundant-*
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/core/(src|include)/.*'
CheckOptions:
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.PrivateMemberSuffix: _
